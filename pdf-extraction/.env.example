OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-6.1-sol
EXTRACTION_REASONING_EFFORT=medium
# Optional. The UI's Mistral OCR switch is off by default.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-1

# Optional: local SQLite journal path. Default: .data/jobs.sqlite3 in this demo.
# EXTRACTION_STATE_PATH=C:/path/to/jobs.sqlite3
# Optional for remote access. Local demo works without a service token.
# EXTRACTION_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
