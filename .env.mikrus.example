# Copy to .env.mikrus and chmod 600 .env.mikrus. Never commit real credentials.
# Mikrus VPS: natan296, SSH forwarding port 10296.
MIKRUS_HOST=natan296.mikrus.xyz
MIKRUS_PORT=10296
MIKRUS_USER=root
MIKRUS_PASSWORD=replace-with-server-password
MIKRUS_HOST_KEY=SHA256:replace-with-verified-ed25519-fingerprint
MIKRUS_DEPLOY_DIR=/root/citycatalyst

# CityCatalyst login on this VPS (separate from the Mikrus account/SSH login).
CC_URL=https://happy-turkey7765.byst.re
CC_LOGIN_EMAIL=admin@citycatalyst.test
CC_LOGIN_PASSWORD=replace-with-citycatalyst-password
