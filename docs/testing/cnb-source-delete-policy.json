{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListConceptNoteSourceArtifacts",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::citycatalyst-files",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "pdf-ocr/sources/concept_note_upload/*",
            "pdf-ocr/results/concept_note_upload/*"
          ]
        }
      }
    },
    {
      "Sid": "DeleteConceptNoteSourceArtifacts",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::citycatalyst-files/pdf-ocr/sources/concept_note_upload/*",
        "arn:aws:s3:::citycatalyst-files/pdf-ocr/results/concept_note_upload/*"
      ]
    }
  ]
}
