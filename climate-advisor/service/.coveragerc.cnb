[run]
data_file = coverage/cnb-edits/.coverage
source = app

[report]
include =
    app/services/cnb/*
    app/persistence/concept_notes/*
    app/models/cnb/*
    app/models/db/cnb_edit.py
    app/routes/concept_note_edits.py
    app/tools/concept_note_edit_tools.py
    app/utils/cnb_observability.py
fail_under = 80
show_missing = True

[json]
output = coverage/cnb-edits/coverage.json
